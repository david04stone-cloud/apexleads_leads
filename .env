# ─────────────────────────────────────────────────────────────
# ApexLeads — Environment Variables
# 
# WHAT TO DO WITH THIS FILE:
# 1. Download it
# 2. Rename it from env-setup.txt to exactly:   .env
#    (yes just .env with a dot at the front, no other text)
# 3. Open it in Notepad (Windows) or TextEdit (Mac)
# 4. Replace every placeholder with your real values
# 5. Save it inside your apexleads-backend folder
#
# NEVER share this file or upload it to GitHub
# ─────────────────────────────────────────────────────────────


# ── ANTHROPIC ──────────────────────────────────────────────
# Get this from: console.anthropic.com → API Keys → Create Key
# Looks like: sk-ant-api03-xxxxxxxxxxxxxxxx

ANTHROPIC_API_KEY=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  


# ── TWILIO ─────────────────────────────────────────────────
# Get these from: console.twilio.com → main dashboard
# Account SID looks like: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token looks like:  a long string of random letters/numbers

TWILIO_ACCOUNT_SID=AC5acc2c73bfedcbf12a2c4a37913be8bd
TWILIO_AUTH_TOKEN=92b91a489f32363da5a2f8ad1ebfdc45

# Your Twilio phone number — Twilio gives you one free on signup
# Find it at: console.twilio.com → Phone Numbers → Manage → Active Numbers
# Must be in this exact format with country code: +17045550100

TWILIO_DEFAULT_NUMBER=+18038067738


# ── PER-CLIENT TWILIO NUMBERS ──────────────────────────────
# Optional for now — use TWILIO_DEFAULT_NUMBER until you have paying clients
# When you buy a dedicated number per client, add it here like this:
# TWILIO_NUMBER_CLIENTID=+1xxxxxxxxxx
#
# Example when you sign Apex HVAC:
# TWILIO_NUMBER_APEX=+17045550101
#
# Example when you sign Green Edge Landscaping:
# TWILIO_NUMBER_GREEN=+18035550102


# ── SECURITY ───────────────────────────────────────────────
# Make up any password — this protects your lead data endpoint
# Example: apexleads2026admin
# Write it down somewhere safe — you'll need it to view leads

DASHBOARD_SECRET=apexleads2026admin


# ── SERVER ─────────────────────────────────────────────────
# Leave PORT as 3000 — Railway will override this automatically
# For ALLOWED_ORIGINS use * for now, update it once you have live URLs

PORT=3000
ALLOWED_ORIGINS=*
